DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/screensharing"
# 32+ random bytes, base64url. Used for PIN HMAC/AES sealing. Rotating it invalidates pending PINs.
APP_SECRET=""
# Public origin of the website; used for CSRF origin checks and email links.
APP_ORIGIN="https://www.screensharing.me"
PIN_TTL_MINUTES=15
DESKTOP_TOKEN_TTL_MINUTES=120
# Optional SMTP for verification / reset email. Without it, mail is written to the MailOutbox table (admin > Mail outbox).
SMTP_URL=""
MAIL_FROM="screensharing.me <no-reply@screensharing.me>"
# One-time first-administrator bootstrap used by `npm run db:seed`. Remove after first run.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD=""
