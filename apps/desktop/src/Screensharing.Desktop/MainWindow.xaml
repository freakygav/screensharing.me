<Window x:Class="Screensharing.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Screensharing.Desktop.Controls"
        xmlns:vm="clr-namespace:Screensharing.Desktop.ViewModels"
        Title="screensharing.me" Width="1180" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Sans}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" Icon="Assets/app.ico">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="Root" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glow -->
            <Border Grid.RowSpan="2" Height="320" VerticalAlignment="Top" Background="{StaticResource GlowBrush}" IsHitTestVisible="False"/>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#B307080C">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Padding="6,0" Command="{Binding BackCommand}" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" ToolTip="Back">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Padding="4,0" Command="{Binding HomeCommand}" ToolTip="Home">
                        <StackPanel Orientation="Horizontal">
                            <c:Logo Width="20" Height="20"/>
                            <TextBlock Margin="9,0,0,0" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center">
                                <Run Text="screensharing"/><Run Text=".me" Foreground="{StaticResource Accent2}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="Connected server">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Ok}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ServerHost}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Visibility="{Binding Elevated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Administrator" FontSize="11.5" Foreground="#D8CEFF"/>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAdminCommand}" ToolTip="Administrator console">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Admin"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenAboutCommand}" ToolTip="About">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
                <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False"/>
        </Grid>
    </Border>
</Window>
