<Application x:Class="Screensharing.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Screensharing.Desktop"
             xmlns:vm="clr-namespace:Screensharing.Desktop.ViewModels"
             xmlns:v="clr-namespace:Screensharing.Desktop.Views"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVis x:Key="BoolToVis"/>
            <local:BoolToVis x:Key="NotBoolToVis" Invert="True"/>
            <local:NullToVis x:Key="NullToVis"/>
            <local:EqualsToVis x:Key="EqualsToVis"/>
            <local:EqualsToVis x:Key="NotEqualsToVis" Invert="True"/>
            <local:ZeroToVis x:Key="ZeroToVis"/>
            <local:ToneBrush x:Key="Tone"/>
            <local:StatusGlyph x:Key="StatusGlyph"/>
            <local:LocalTime x:Key="LocalTime"/>
            <local:Bytes x:Key="Bytes"/>

            <DataTemplate DataType="{x:Type vm:ConnectViewModel}"><v:ConnectView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PinViewModel}"><v:PinView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InvestigationViewModel}"><v:InvestigationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScanViewModel}"><v:ScanView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EvidenceViewModel}"><v:EvidenceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StaffLoginViewModel}"><v:StaffLoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StaffDashboardViewModel}"><v:StaffDashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
