<UserControl x:Class="Screensharing.Desktop.Controls.PinBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Digit" TargetType="TextBox">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent2}"/>
            <Setter Property="MaxLength" Value="1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBox x:Name="D0" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 1"/>
        <TextBox x:Name="D1" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 2"/>
        <TextBox x:Name="D2" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 3"/>
        <TextBlock Text="–" FontSize="30" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0"/>
        <TextBox x:Name="D3" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 4"/>
        <TextBox x:Name="D4" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 5"/>
        <TextBox x:Name="D5" Style="{StaticResource Digit}" AutomationProperties.Name="PIN digit 6"/>
    </StackPanel>
</UserControl>
