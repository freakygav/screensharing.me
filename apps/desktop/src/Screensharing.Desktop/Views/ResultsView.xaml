<UserControl x:Class="Screensharing.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DETECTION RESULTS" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Investigation report" Style="{StaticResource H1}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SubTitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnSmall}" Command="{Binding ExportCommand}" CommandParameter="pdf" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="PDF"/></StackPanel></Button>
                <Button Style="{StaticResource BtnSmall}" Command="{Binding ExportCommand}" CommandParameter="json" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="JSON"/></StackPanel></Button>
                <Button Style="{StaticResource BtnSmall}" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="CSV"/></StackPanel></Button>
                <Button Style="{StaticResource BtnSmall}" Content="Done" Command="{Binding DoneCommand}" Visibility="{Binding FromServer, Converter={StaticResource NotBoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- Verdict -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Padding="20,16" BorderThickness="1"
                Background="{Binding VerdictLevel, Converter={StaticResource Tone}, ConverterParameter=soft}"
                BorderBrush="{Binding VerdictLevel, Converter={StaticResource Tone}, ConverterParameter=border}">
            <StackPanel>
                <TextBlock Text="OVERALL INVESTIGATION STATUS" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding VerdictTitle}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="{Binding VerdictText}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding UploadError, StringFormat='Upload to the investigator did not complete: {0} The local report is still available for export.'}" Foreground="{StaticResource Med}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding UploadError, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding ExportMessage}" Foreground="{StaticResource Ok}" FontSize="12.5" Margin="0,8,0,0" Visibility="{Binding ExportMessage, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Counters -->
        <UniformGrid Grid.Row="2" Columns="7" Margin="0,12,0,0">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total findings" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Total}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Critical" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Critical}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Crit}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="High" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding High}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource High}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Medium" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Medium}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Med}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Low" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Low}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Blue}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Inconclusive" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Inconclusive}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="14,10"><StackPanel><TextBlock Text="Integrity" Foreground="{StaticResource Muted}" FontSize="11.5"/><TextBlock Text="{Binding Integrity}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0" Foreground="{Binding Integrity, Converter={StaticResource Tone}}"/></StackPanel></Border>
        </UniformGrid>

        <!-- Filters -->
        <Grid Grid.Row="3" Margin="0,14,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="30,0,10,0" AutomationProperties.Name="Search findings"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Foreground="{StaticResource Dim}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <TextBlock Text="Search findings, rules, paths, hashes…" Foreground="{StaticResource Dim}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Search.Length}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="1" Style="{StaticResource Select}" Width="150" Margin="8,0,0,0" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"/>
            <ComboBox Grid.Column="2" Style="{StaticResource Select}" Width="190" Margin="8,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
            <ComboBox Grid.Column="3" Style="{StaticResource Select}" Width="170" Margin="8,0,0,0" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"/>
            <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="Expand all" Margin="6,0,0,0" Command="{Binding ExpandAllCommand}"/>
        </Grid>

        <!-- Findings -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="No findings. No examined artifact matched a detection rule." HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Visible.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                <StackPanel>
                                    <Button Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="h" Background="Transparent" Padding="18,13"><ContentPresenter/></Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="Background" Value="#06FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding Item.Severity, Converter={StaticResource Tone}}" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                                <TextBlock Text="{Binding Item.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                    <Run Text="{Binding Item.Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Item.RuleId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Item.PrimaryReference, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="0,0,6,0"><TextBlock Text="{Binding Item.TierLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Item.Tier, Converter={StaticResource Tone}}"/></Border>
                                            <Border Grid.Column="3" Style="{StaticResource Chip}" Background="{Binding Item.Severity, Converter={StaticResource Tone}, ConverterParameter=soft}" BorderBrush="{Binding Item.Severity, Converter={StaticResource Tone}, ConverterParameter=border}">
                                                <TextBlock Text="{Binding Item.Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Item.Severity, Converter={StaticResource Tone}}"/>
                                            </Border>
                                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Ink2}"><Run Text="{Binding Item.Confidence, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Dim}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Text" Value="&#xE76C;"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Expanded}" Value="True"><Setter Property="Text" Value="&#xE70D;"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,16" Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Body}"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="WHY THIS MATTERS" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Text="{Binding Item.WhyItMatters}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,12"/>
                                                    <TextBlock Text="LIMITATIONS" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Text="{Binding Item.Limitations}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="DETECTION METHOD" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Text="{Binding Item.Method}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,12"/>
                                                    <TextBlock Text="ALTERNATIVE EXPLANATIONS" Style="{StaticResource Eyebrow}"/>
                                                    <TextBlock Text="{Binding Item.AlternativeExplanations}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Margin="0,14,0,6" Style="{StaticResource Eyebrow}"><Run Text="EVIDENCE ("/><Run Text="{Binding Item.Evidence.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                                            <ItemsControl ItemsSource="{Binding Item.Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Style="{StaticResource Chip}" Padding="6,0"><TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource Muted}"/></Border>
                                                                    <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Reference}" Style="{StaticResource MonoText}" Foreground="{StaticResource Ink}" Margin="0,6,0,0"/>
                                                                <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding Sha256, Converter={StaticResource NullToVis}}"><Run Text="sha256 " Foreground="{StaticResource Dim}"/><Run Text="{Binding Sha256, Mode=OneWay}"/></TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource BtnSmall}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding DataContext.OpenEvidenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Open evidence viewer"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SCAN COVERAGE" Style="{StaticResource Eyebrow}" Margin="0,18,0,8"/>
                <Border Style="{StaticResource Card}" Padding="16,10">
                    <ItemsControl ItemsSource="{Binding Report.Coverage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource Tone}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="12.5"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,8,0,10" Text="Skipped modules mean that evidence was not examined — not that it was clean."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
