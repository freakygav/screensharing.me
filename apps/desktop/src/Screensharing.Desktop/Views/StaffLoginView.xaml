<UserControl x:Class="Screensharing.Desktop.Views.StaffLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Screensharing.Desktop.Controls">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <c:Logo Width="44" Height="44" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,6,0" Visibility="{Binding AdminOnly, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="360"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="22">
                <StackPanel>
                    <Border Margin="0,0,0,14" CornerRadius="6" Padding="12,9" Background="{StaticResource CritSoft}" BorderBrush="#59E5484D" BorderThickness="1" Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding Error}" Foreground="#F6C3C5" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Username or email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="Id" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Password" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="Pw" KeyDown="Pw_KeyDown"/>
                    <Button Style="{StaticResource BtnPrimary}" Height="42" Margin="0,20,0,0" Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=Pw}" IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"
                            xmlns:local="clr-namespace:Screensharing.Desktop">
                        <TextBlock Text="Sign in"/>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextAlignment="Center" Margin="0,16,0,0" Text="Credentials are verified by the server and never stored on this computer."/>
        </StackPanel>
    </Grid>
</UserControl>
