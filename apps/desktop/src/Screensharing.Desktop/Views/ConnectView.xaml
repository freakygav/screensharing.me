<UserControl x:Class="Screensharing.Desktop.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Screensharing.Desktop.Controls">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <c:Logo Width="56" Height="56" HorizontalAlignment="Center"/>
            <TextBlock Text="Welcome to screensharing.me" Style="{StaticResource H1}" FontSize="28" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock Text="Minecraft forensic investigations. Read-only, consent-first, evidence-backed." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Crit}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{StaticResource Ok}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Checking}" Value="True"><Setter Property="Fill" Value="{StaticResource Med}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" MaxWidth="380"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateNotice}" Visibility="{Binding UpdateNotice, Converter={StaticResource NullToVis}}" Foreground="{StaticResource Med}" FontSize="12.5" Margin="18,6,0,0"/>

                    <Border Style="{StaticResource Inset}" Margin="0,16,0,0" Visibility="{Binding ResumeReference, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Unfinished investigation" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12"><Run Text="Resume "/><Run Text="{Binding ResumeReference}" FontFamily="{StaticResource Mono}"/></TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnSmall}" Content="Resume" Command="{Binding ResumeCommand}"/>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource BtnPrimary}" Height="44" Margin="0,18,0,0" Command="{Binding EnterPinCommand}" IsEnabled="{Binding Online}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Margin="0,0,8,0"/><TextBlock Text="I have an investigation PIN"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSecondary}" Height="40" Margin="0,10,0,0" Command="{Binding StaffSignInCommand}" IsEnabled="{Binding Online}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Margin="0,0,8,0"/><TextBlock Text="Staff sign in"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Margin="0,10,0,0" HorizontalAlignment="Center" Command="{Binding CheckCommand}" Visibility="{Binding Online, Converter={StaticResource NotBoolToVis}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Retry connection"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextAlignment="Center" Margin="0,18,0,0"
                       Text="This application never modifies your files and collects nothing until you give consent."/>
        </StackPanel>
    </Grid>
</UserControl>
